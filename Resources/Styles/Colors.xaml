<ResourceDictionary xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">
    <Color x:Key="Primary">#007AFF</Color>
    <Color x:Key="PrimaryDark">#0A84FF</Color>
    <Color x:Key="PrimaryDarkText">#FFFFFF</Color>
    <Color x:Key="Secondary">#8E8E93</Color>
    <Color x:Key="SecondaryDarkText">#AEAEB2</Color>
    <Color x:Key="Tertiary">#007AFF</Color>

    <Color x:Key="White">#FFFFFF</Color>
    <Color x:Key="Black">#000000</Color>
    <Color x:Key="SystemBackground">#F2F2F7</Color>
    <Color x:Key="SystemBackgroundDark">#000000</Color>
    <Color x:Key="SecondarySystemBackground">#FFFFFF</Color>
    <Color x:Key="SecondarySystemBackgroundDark">#1C1C1E</Color>
    <Color x:Key="SearchBackground">#E5E5EA</Color>
    <Color x:Key="SearchBackgroundDark">#1C1C1E</Color>
    <Color x:Key="Separator">#C6C6C8</Color>
    <Color x:Key="SeparatorDark">#38383A</Color>

    <Color x:Key="Gray100">#F2F2F7</Color>
    <Color x:Key="Gray200">#C6C6C8</Color>
    <Color x:Key="Gray300">#AEAEB2</Color>
    <Color x:Key="Gray400">#8E8E93</Color>
    <Color x:Key="Gray500">#636366</Color>
    <Color x:Key="Gray600">#48484A</Color>
    <Color x:Key="Gray900">#1C1C1E</Color>
    <Color x:Key="Gray950">#000000</Color>

    <Color x:Key="LevelRed">#FF3B30</Color>
    <Color x:Key="LevelOrange">#FF9500</Color>
    <Color x:Key="LevelYellow">#FFCC00</Color>
    <Color x:Key="LevelGreenLight">#34C759</Color>
    <Color x:Key="LevelGreen">#248A3D</Color>

    <SolidColorBrush x:Key="PrimaryBrush" Color="{StaticResource Primary}" />
    <SolidColorBrush x:Key="SecondaryBrush" Color="{StaticResource Secondary}" />
    <SolidColorBrush x:Key="TertiaryBrush" Color="{StaticResource Tertiary}" />
    <SolidColorBrush x:Key="WhiteBrush" Color="{StaticResource White}" />
    <SolidColorBrush x:Key="BlackBrush" Color="{StaticResource Black}" />
</ResourceDictionary>