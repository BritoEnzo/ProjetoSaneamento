<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:SaneaBrasil.ViewModels"
             xmlns:models="clr-namespace:SaneaBrasil.Models"
             x:Class="SaneaBrasil.Views.FavoritosPage"
             x:DataType="vm:FavoritosViewModel"
             Title="{Binding Titulo}">

    <CollectionView Margin="16"
                    ItemsSource="{Binding Municipios}"
                    SelectionMode="Single"
                    SelectedItem="{Binding MunicipioSelecionado}">
        <CollectionView.Header>
            <Label Text="Seus municípios salvos" FontSize="20" FontAttributes="Bold" Margin="0,0,0,8" />
        </CollectionView.Header>
        <CollectionView.EmptyView>
            <VerticalStackLayout Padding="24" Spacing="8">
                <Label Text="☆" FontSize="48" HorizontalOptions="Center" TextColor="Gray" />
                <Label Text="Nenhum favorito ainda. Abra um município e toque em “Adicionar aos favoritos”."
                       HorizontalTextAlignment="Center" TextColor="Gray" />
            </VerticalStackLayout>
        </CollectionView.EmptyView>
        <CollectionView.ItemTemplate>
            <DataTemplate x:DataType="models:Municipio">
                <Border Margin="0,4" Padding="14" StrokeShape="RoundRectangle 10" Stroke="#CFD8DC">
                    <VerticalStackLayout>
                        <Label Text="{Binding NomeCompleto}" FontSize="17" FontAttributes="Bold" />
                        <Label Text="{Binding Descricao}" FontSize="12" TextColor="Gray" />
                    </VerticalStackLayout>
                </Border>
            </DataTemplate>
        </CollectionView.ItemTemplate>
    </CollectionView>
</ContentPage>
