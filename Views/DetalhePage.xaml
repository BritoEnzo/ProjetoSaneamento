<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:SaneaBrasil.ViewModels"
             xmlns:ind="clr-namespace:SaneaBrasil.Models.Indicadores"
             xmlns:conv="clr-namespace:SaneaBrasil.Converters"
             x:Class="SaneaBrasil.Views.DetalhePage"
             x:DataType="vm:DetalheViewModel"
             Title="{Binding Titulo}">

    <ContentPage.Resources>
        <conv:NivelParaCorConverter x:Key="NivelParaCor" />
    </ContentPage.Resources>

    <ContentPage.ToolbarItems>
        <ToolbarItem IconImageSource="star.svg"
                     Command="{Binding AlternarFavoritoCommand}" />
    </ContentPage.ToolbarItems>

    <RefreshView Command="{Binding RecarregarCommand}" IsRefreshing="{Binding Carregando, Mode=OneWay}">
        <ScrollView>
            <VerticalStackLayout Padding="16" Spacing="32">

                <Label Text="{Binding NomeMunicipio}" FontSize="34" FontAttributes="Bold" />
                <Label Text="{Binding ContextoBairro}" FontSize="13" TextColor="{AppThemeBinding Light=#8E8E93, Dark=#AEAEB2}" />
                <Label Text="{Binding PopulacaoTexto}" FontSize="14" TextColor="{AppThemeBinding Light=#8E8E93, Dark=#AEAEB2}" />

                <Label Text="{Binding MensagemErro}" IsVisible="{Binding TemErro}" TextColor="#FF3B30" FontSize="13" />

                <Grid IsVisible="{Binding TemIndice}" HorizontalOptions="Center" WidthRequest="176" HeightRequest="176">
                    <Border StrokeThickness="8"
                            Stroke="{AppThemeBinding Light=#C6C6C8, Dark=#38383A}"
                            Background="Transparent"
                            StrokeShape="Ellipse"
                            WidthRequest="176"
                            HeightRequest="176" />
                    <Border StrokeThickness="8"
                            Stroke="{Binding NivelGeral, Converter={StaticResource NivelParaCor}}"
                            Background="Transparent"
                            StrokeShape="Ellipse"
                            WidthRequest="176"
                            HeightRequest="176"
                            Margin="6" />
                    <VerticalStackLayout HorizontalOptions="Center" VerticalOptions="Center" Spacing="2">
                        <Label Text="{Binding IndiceTexto}" FontSize="34" FontAttributes="Bold"
                               HorizontalTextAlignment="Center" />
                        <Label Text="{Binding NivelTexto}" FontSize="13" FontAttributes="Bold"
                               TextColor="{Binding NivelGeral, Converter={StaticResource NivelParaCor}}"
                               HorizontalTextAlignment="Center" />
                        <Label Text="de 100" FontSize="13"
                               TextColor="{AppThemeBinding Light=#8E8E93, Dark=#AEAEB2}"
                               HorizontalTextAlignment="Center" />
                    </VerticalStackLayout>
                </Grid>

                <VerticalStackLayout Spacing="8">
                    <Label Text="INDICADORES" FontSize="13"
                           TextColor="{AppThemeBinding Light=#8E8E93, Dark=#AEAEB2}" />
                    <Border Padding="16,8" StrokeThickness="0">
                        <VerticalStackLayout BindableLayout.ItemsSource="{Binding Indicadores}" Spacing="0">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="ind:IndicadorSaneamento">
                                    <VerticalStackLayout Padding="0,12" Spacing="8">
                                        <Grid ColumnDefinitions="*,Auto">
                                            <Label Text="{Binding Nome}" FontSize="17" FontAttributes="Bold" />
                                            <Label Grid.Column="1" Text="{Binding PercentualTexto}" FontSize="17"
                                                   TextColor="{Binding Nivel, Converter={StaticResource NivelParaCor}}" />
                                        </Grid>
                                        <ProgressBar Progress="{Binding Fracao}" HeightRequest="4"
                                                     ProgressColor="{Binding Nivel, Converter={StaticResource NivelParaCor}}" />
                                        <Label Text="{Binding Resumo}" FontSize="13"
                                               TextColor="{AppThemeBinding Light=#8E8E93, Dark=#AEAEB2}" />
                                    </VerticalStackLayout>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>
                    </Border>
                </VerticalStackLayout>

                <Button Text="Como o índice é calculado?"
                        BackgroundColor="Transparent" TextColor="#007AFF"
                        BorderWidth="0"
                        CornerRadius="8"
                        FontSize="17"
                        HeightRequest="44"
                        Command="{Binding ComoCalculamosCommand}" />

                <Label Text="{Binding FonteTexto}" FontSize="13" TextColor="{AppThemeBinding Light=#8E8E93, Dark=#AEAEB2}" />
            </VerticalStackLayout>
        </ScrollView>
    </RefreshView>
</ContentPage>
