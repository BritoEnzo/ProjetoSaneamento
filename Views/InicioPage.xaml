<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:SaneaBrasil.ViewModels"
             xmlns:models="clr-namespace:SaneaBrasil.Models"
             x:Class="SaneaBrasil.Views.InicioPage"
             x:DataType="vm:InicioViewModel"
             Title="{Binding Titulo}">

    <ScrollView>
        <VerticalStackLayout Padding="24" Spacing="16">

            <Label Text="💧 SaneaBrasil"
                   FontSize="32" FontAttributes="Bold"
                   HorizontalOptions="Center" />

            <Label Text="Consulte o saneamento dos bairros da Zona Leste de São Paulo, com dados municipais oficiais do Censo 2022 do IBGE."
                   FontSize="15" HorizontalTextAlignment="Center" />

            <Border Padding="16" StrokeShape="RoundRectangle 12" Stroke="#1565C0">
                <VerticalStackLayout Spacing="12">
                    <Label Text="Buscar bairro da Zona Leste" FontSize="18" FontAttributes="Bold" />
                    <SearchBar Placeholder="Ex.: Tatuapé, Itaquera, São Mateus"
                               Text="{Binding Filtro}" />
                    <Label Text="{Binding MensagemErro}" IsVisible="{Binding TemErro}" TextColor="#C62828" />
                    <CollectionView ItemsSource="{Binding Bairros}"
                                    SelectionMode="Single"
                                    SelectedItem="{Binding BairroSelecionado}"
                                    MaximumHeightRequest="300">
                        <CollectionView.EmptyView>
                            <Label Text="Nenhum bairro encontrado." HorizontalOptions="Center" TextColor="Gray" />
                        </CollectionView.EmptyView>
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="models:Bairro">
                                <VerticalStackLayout Padding="8,10">
                                    <Label Text="{Binding Nome}" FontSize="16" FontAttributes="Bold" />
                                    <Label Text="{Binding Descricao}" FontSize="12" TextColor="Gray" />
                                    <BoxView HeightRequest="1" Color="#ECEFF1" Margin="0,6,0,0" />
                                </VerticalStackLayout>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </VerticalStackLayout>
            </Border>

            <Label Text="ou" HorizontalOptions="Center" />

            <Button Text="Explorar por estado e cidade"
                    BorderColor="#1565C0" BorderWidth="2"
                    BackgroundColor="Transparent" TextColor="#1565C0"
                    Command="{Binding ExplorarEstadosCommand}" />

            <Label Text="Dica: abra o menu lateral (☰) para ver as informações do app."
                   FontSize="12" TextColor="Gray" HorizontalTextAlignment="Center" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
