<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:SaneaBrasil.ViewModels"
             xmlns:models="clr-namespace:SaneaBrasil.Models"
             x:Class="SaneaBrasil.Views.InicioPage"
             x:DataType="vm:InicioViewModel"
             Title="Saneamento">

    <ScrollView>
        <VerticalStackLayout Padding="16" Spacing="16">
            <Label Text="Saneamento" FontSize="34" FontAttributes="Bold" Margin="0,8,0,0" />

            <SearchBar Placeholder="Buscar bairro"
                       Text="{Binding Filtro}" />

            <Label Text="ZONA LESTE" FontSize="13"
                   TextColor="{AppThemeBinding Light=#8E8E93, Dark=#AEAEB2}" />

            <Label Text="{Binding MensagemErro}" IsVisible="{Binding TemErro}" TextColor="#FF3B30" FontSize="13" />

            <Border Padding="0" StrokeThickness="0" VerticalOptions="Start">
                <CollectionView ItemsSource="{Binding Bairros}"
                                SelectionMode="Single"
                                SelectedItem="{Binding BairroSelecionado}"
                                MaximumHeightRequest="300">
                    <CollectionView.EmptyView>
                        <Label Text="Nenhum bairro encontrado."
                               HorizontalOptions="Center"
                               Margin="16,24"
                               FontSize="15"
                               TextColor="{AppThemeBinding Light=#8E8E93, Dark=#AEAEB2}" />
                    </CollectionView.EmptyView>
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="models:Bairro">
                            <Grid ColumnDefinitions="*,16" MinimumHeightRequest="44" Padding="16,0">
                                <Label Text="{Binding Nome}" FontSize="17" VerticalOptions="Center" />
                                <Label Grid.Column="1" Text="›" FontSize="22" HorizontalTextAlignment="End"
                                       TextColor="{AppThemeBinding Light=#C6C6C8, Dark=#8E8E93}"
                                       VerticalOptions="Center" />
                            </Grid>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </Border>

            <Label Text="EXPLORAR" FontSize="13"
                   TextColor="{AppThemeBinding Light=#8E8E93, Dark=#AEAEB2}" />

            <Border Padding="0" StrokeThickness="0" MinimumHeightRequest="44">
                <Button Text="Explorar por estado e cidade"
                        BackgroundColor="Transparent"
                        TextColor="#007AFF"
                        CornerRadius="10"
                        Padding="16,0"
                        HorizontalOptions="Fill"
                        Command="{Binding ExplorarEstadosCommand}" />
            </Border>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
