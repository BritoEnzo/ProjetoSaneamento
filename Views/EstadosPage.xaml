<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:SaneaBrasil.ViewModels"
             xmlns:models="clr-namespace:SaneaBrasil.Models"
             x:Class="SaneaBrasil.Views.EstadosPage"
             x:DataType="vm:EstadosViewModel"
             Title="Estados">

    <ScrollView>
        <VerticalStackLayout Padding="16" Spacing="16">
            <Label Text="ESTADOS" FontSize="13" TextColor="{AppThemeBinding Light=#8E8E93, Dark=#AEAEB2}" />

            <ActivityIndicator IsRunning="{Binding Carregando}" IsVisible="{Binding Carregando}" Color="#007AFF" />
            <Label Text="{Binding MensagemErro}" IsVisible="{Binding TemErro}" TextColor="#FF3B30" FontSize="13" />

            <Border Padding="0" StrokeThickness="0">
                <CollectionView ItemsSource="{Binding Estados}"
                                SelectionMode="Single"
                                SelectedItem="{Binding EstadoSelecionado}">
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="models:Estado">
                            <Grid ColumnDefinitions="*,Auto,16" MinimumHeightRequest="44" Padding="16,0">
                                <Label Text="{Binding Nome}" FontSize="17" VerticalOptions="Center" />
                                <Label Grid.Column="1" Text="{Binding Sigla}" FontSize="15"
                                       TextColor="{AppThemeBinding Light=#8E8E93, Dark=#AEAEB2}"
                                       VerticalOptions="Center" />
                                <Label Grid.Column="2" Text="›" FontSize="22" HorizontalTextAlignment="End"
                                       TextColor="{AppThemeBinding Light=#C6C6C8, Dark=#8E8E93}"
                                       VerticalOptions="Center" />
                            </Grid>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </Border>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
