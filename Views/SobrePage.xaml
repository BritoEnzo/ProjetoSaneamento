<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="SaneaBrasil.Views.SobrePage"
             Title="Sobre o app">

    <ScrollView>
        <VerticalStackLayout Padding="16" Spacing="32">
            <Label Text="Sobre o SaneaBrasil" FontSize="34" FontAttributes="Bold" />

            <Label Text="O app consulta, por município, a cobertura de abastecimento de água, esgotamento sanitário e coleta de lixo registrada no Censo Demográfico 2022, e combina os três num índice de 0 a 100." />

            <Label Text="APIs utilizadas" FontSize="18" FontAttributes="Bold" />
            <Label Text="1. IBGE Localidades: lista de estados e municípios." />
            <Label Text="2. IBGE Agregados (SIDRA): dados do Censo 2022 (tabelas 6804, 6805, 6892 e 4714)." />
            <Label Text="3. Busca local: filtra bairros da Zona Leste de São Paulo; os dados exibidos são municipais." />

            <Label Text="NAVEGAÇÃO" FontSize="13" TextColor="{AppThemeBinding Light=#8E8E93, Dark=#AEAEB2}" />
            <Border Padding="16" StrokeThickness="0">
                <VerticalStackLayout Spacing="8">
                    <Label Text="Menu lateral: alterna entre o app e esta tela." FontSize="15" />
                    <Label Text="Abas: Início, Estados e Favoritos." FontSize="15" />
                    <Label Text="Pilha: Estados, Municípios e Detalhe." FontSize="15" />
                    <Label Text="Sheet: Como o índice é calculado." FontSize="15" />
                </VerticalStackLayout>
            </Border>

            <Label Text="Os dados são públicos e pertencem ao IBGE. Este é um projeto acadêmico."
                   FontSize="13" TextColor="{AppThemeBinding Light=#8E8E93, Dark=#AEAEB2}" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
