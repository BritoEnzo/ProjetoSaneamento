<?xml version="1.0" encoding="UTF-8" ?>
<!--
    Os três tipos de navegação do app:
      1. Flyout (menu lateral)   -> FlyoutItem "Saneamento" e "Sobre o app"
      2. Tabs (abas)             -> Início / Estados / Favoritos dentro do primeiro FlyoutItem
      3. Pilha (push) + Modal    -> rotas "municipios", "detalhe" e "sobredados" (registradas em AppShell.xaml.cs)
-->
<Shell x:Class="SaneaBrasil.AppShell"
       xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
       xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
       xmlns:views="clr-namespace:SaneaBrasil.Views"
       Title="SaneaBrasil"
       FlyoutBehavior="Flyout"
       FlyoutBackgroundColor="{AppThemeBinding Light={StaticResource SystemBackground}, Dark={StaticResource SystemBackgroundDark}}"
       Shell.BackgroundColor="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource Black}}"
       Shell.ForegroundColor="{AppThemeBinding Light={StaticResource Black}, Dark={StaticResource White}}"
       Shell.TitleColor="{AppThemeBinding Light={StaticResource Black}, Dark={StaticResource White}}"
       Shell.NavBarHasShadow="False"
       Shell.TabBarBackgroundColor="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource SecondarySystemBackgroundDark}}"
       Shell.TabBarTitleColor="#007AFF"
       Shell.TabBarForegroundColor="#007AFF"
       Shell.TabBarUnselectedColor="#8E8E93">

    <FlyoutItem Title="Saneamento" Icon="tab_inicio.svg" FlyoutDisplayOptions="AsSingleItem">
        <Tab Title="Início" Icon="tab_inicio.svg">
            <ShellContent Title="Início"
                          ContentTemplate="{DataTemplate views:InicioPage}"
                          Route="inicio" />
        </Tab>
        <Tab Title="Estados" Icon="tab_estados.svg">
            <ShellContent Title="Estados"
                          ContentTemplate="{DataTemplate views:EstadosPage}"
                          Route="estados" />
        </Tab>
        <Tab Title="Favoritos" Icon="tab_favoritos.svg">
            <ShellContent Title="Favoritos"
                          ContentTemplate="{DataTemplate views:FavoritosPage}"
                          Route="favoritos" />
        </Tab>
    </FlyoutItem>

    <FlyoutItem Title="Sobre o app" Icon="sobre.svg">
        <ShellContent Title="Sobre o app"
                      ContentTemplate="{DataTemplate views:SobrePage}"
                      Route="sobre" />
    </FlyoutItem>
</Shell>
